# Copy to .env.local for local dev. On Vercel, add these as Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: free CARTO basemaps key for the dark map (https://carto.com/basemaps/apikey/).
# Without it the app uses OpenStreetMap tiles with a dark filter.
VITE_CARTO_KEY=
